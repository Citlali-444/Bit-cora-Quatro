<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bitácora Quatro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#000000;
    --paper-2:#141414;
    --card:#FFFFFF;
    --ink:#F2F0EA;
    --ink-on-card:#221D19;
    --muted:#A8A29A;
    --muted-on-card:#7A7264;
    --line:#2B2B2B;
    --line-on-card:#D8D2C4;
    --red:#C4453A;
    --red-dark:#E2665A;
    --red-oncard:#A32D22;
    --teal:#4FA394;
    --teal-bg:#1C2E2A;
    --teal-oncard:#256156;
    --font-display:'Oswald',sans-serif;
    --font-body:'IBM Plex Sans',sans-serif;
    --font-mono:'IBM Plex Mono',monospace;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font-body);}
  body::before{content:'';position:fixed;inset:0;background-image:url('data:image/jpeg;base64,');background-size:cover;background-position:center;opacity:.16;z-index:0;}
  body::after{content:'';position:fixed;inset:0;background:linear-gradient(180deg, rgba(0,0,0,.55), rgba(0,0,0,.75));z-index:0;}
  .wrap{max-width:760px;margin:0 auto;padding:28px 20px 60px;position:relative;z-index:1;}
  .logo{position:absolute;top:24px;right:20px;height:44px;width:auto;border-radius:4px;}
  .eyebrow{font-family:var(--font-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0 0 6px;}
  h1{font-family:var(--font-display);font-weight:700;font-size:34px;letter-spacing:.01em;margin:0 0 10px;text-transform:uppercase;}
  .rule{height:5px;background:var(--red);border-radius:2px;margin-bottom:22px;position:relative;}
  .rule::after{content:'';position:absolute;left:0;right:0;top:9px;height:1.5px;background:var(--red);opacity:.55;}
  .datebar{display:flex;align-items:center;gap:12px;margin-bottom:22px;flex-wrap:wrap;}
  .datebar label{font-family:var(--font-mono);font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);}
  input[type=date]{font-family:var(--font-mono);font-size:15px;padding:7px 10px;border:1px solid var(--line-on-card);border-radius:4px;background:var(--card);color:var(--ink-on-card);}
  .section-title{font-family:var(--font-display);font-size:16px;text-transform:uppercase;letter-spacing:.06em;margin:30px 0 12px;color:var(--red-dark);display:flex;align-items:center;gap:8px;}
  .section-title .n{font-family:var(--font-mono);font-size:12px;color:var(--muted);}
  .panel{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px 18px;color:var(--ink-on-card);}
  .grid-form{display:grid;grid-template-columns:90px 140px 1fr;gap:10px;margin-bottom:10px;}
  .grid-form .full{grid-column:1/-1;}
  label.f{display:block;font-family:var(--font-mono);font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted-on-card);margin-bottom:4px;}
  input[type=text],select,textarea{width:100%;font-family:var(--font-body);font-size:14px;padding:8px 9px;border:1px solid var(--line-on-card);border-radius:4px;background:#fff;color:var(--ink-on-card);}
  input[type=text]:focus,select:focus,textarea:focus{outline:2px solid var(--teal);outline-offset:1px;}
  .btn{font-family:var(--font-mono);font-size:12px;text-transform:uppercase;letter-spacing:.06em;padding:9px 16px;border-radius:5px;border:1px solid var(--ink);background:var(--ink);color:#000;cursor:pointer;}
  .btn:hover{opacity:.88;}
  .btn.secondary{background:transparent;color:var(--ink);border:1px solid var(--line);}
  .btn.red{background:var(--red);border-color:var(--red);color:#fff;}
  .btn.small{padding:5px 10px;font-size:11px;}
  .btn:disabled{opacity:.5;cursor:not-allowed;}
  .err{color:var(--red-oncard);font-size:12px;margin:2px 0 0;font-family:var(--font-mono);}
  .entries{display:flex;flex-direction:column;gap:10px;margin-top:6px;}
  .ticket{display:flex;gap:14px;align-items:flex-start;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:12px 14px 12px 0;position:relative;overflow:hidden;color:var(--ink-on-card);}
  .ticket::before{content:'';position:absolute;left:0;top:0;bottom:0;width:26px;background-image:radial-gradient(circle at 13px 10px, var(--paper) 4px, transparent 4.5px);background-repeat:repeat-y;background-size:26px 20px;border-right:1.5px dashed var(--line);}
  .parada{font-family:var(--font-mono);font-size:13px;color:var(--muted-on-card);min-width:36px;text-align:center;padding-top:2px;margin-left:26px;}
  .ticket-body{flex:1;min-width:0;}
  .stamp{display:inline-block;font-family:var(--font-mono);font-weight:600;font-size:14px;letter-spacing:.04em;color:var(--red-oncard);border:1.5px solid var(--red-oncard);border-radius:4px;padding:2px 8px;transform:rotate(-1.2deg);margin-bottom:6px;}
  .tipo-badge{display:inline-block;font-family:var(--font-mono);font-size:11px;text-transform:uppercase;letter-spacing:.05em;background:var(--teal-bg);color:var(--teal);padding:2px 8px;border-radius:3px;margin-left:8px;vertical-align:2px;}
  .nota{font-size:14px;line-height:1.5;margin:2px 0 0;}
  .meta{font-family:var(--font-mono);font-size:11px;color:var(--muted-on-card);margin-top:6px;}
  .actions{display:flex;flex-direction:column;gap:2px;padding-top:2px;}
  .iconbtn{background:none;border:none;color:var(--muted-on-card);cursor:pointer;font-family:var(--font-mono);font-size:11px;text-transform:uppercase;letter-spacing:.04em;padding:2px 4px;text-align:right;}
  .iconbtn:hover{color:var(--teal-oncard);}
  .hist-toggle{background:none;border:none;color:var(--teal-oncard);cursor:pointer;font-family:var(--font-mono);font-size:11px;text-decoration:underline;padding:0;margin-top:4px;}
  .hist-list{margin:6px 0 0;padding:8px 10px;background:#F0EEE7;border-radius:5px;font-family:var(--font-mono);font-size:11px;color:var(--muted-on-card);display:flex;flex-direction:column;gap:3px;}
  .edit-form{display:grid;grid-template-columns:80px 130px 1fr;gap:8px;margin-bottom:8px;}
  .edit-form .full{grid-column:1/-1;}
  .edit-actions{display:flex;gap:8px;}
  .panel .btn.secondary,.ticket .btn.secondary{color:var(--ink-on-card);border-color:var(--line-on-card);}
  .empty{font-family:var(--font-mono);font-size:13px;color:var(--muted);padding:20px 0;text-align:center;border:1px dashed var(--line);border-radius:8px;}
  textarea{font-family:var(--font-body);font-size:14px;resize:vertical;}
  .search{display:flex;gap:8px;margin-bottom:6px;}
  .search input{flex:1;}
  .result-date{font-family:var(--font-mono);font-size:11px;color:var(--muted-on-card);margin:14px 0 6px;text-transform:uppercase;letter-spacing:.06em;}
  .hint{font-size:12px;color:var(--muted);margin-top:4px;}
  @media(max-width:520px){
    .grid-form{grid-template-columns:1fr 1fr;}
    .grid-form .wide{grid-column:1/-1;}
    .edit-form{grid-template-columns:1fr 1fr;}
    .edit-form .full{grid-column:1/-1;}
  }
</style>
</head>
<body>
<div class="wrap">

  <img class="logo" src="data:image/png;base64," alt="Kassël home & living">
  <p class="eyebrow">Registro compartido</p>
  <h1>Bitácora de rutas</h1>
  <div class="rule"></div>

  <div class="datebar">
    <label for="routeDate">Fecha de ruta</label>
    <input type="date" id="routeDate">
    <button class="btn secondary small" id="todayBtn" type="button">Hoy</button>
    <span class="hint" id="dateHint"></span>
  </div>
  <div id="storageBanner" style="display:none;font-family:var(--font-mono);font-size:12px;color:var(--red-oncard);background:#F3E2D8;border:1px solid var(--red);border-radius:6px;padding:8px 12px;margin-bottom:18px;"></div>

  <div class="section-title">Agregar jaula <span class="n">manual</span></div>
  <div class="panel">
    <div class="grid-form">
      <div><label class="f">Jaula</label><input type="text" id="fParada" placeholder="1"></div>
      <div><label class="f">Código</label><input type="text" id="fCodigo" placeholder="OZA1326" style="font-family:var(--font-mono);text-transform:uppercase;"></div>
      <div class="wide"><label class="f">Tipo</label>
        <input type="text" id="fTipo" list="tiposList" placeholder="Mercancía de piso Puebla">
        <datalist id="tiposList">
          <option value="Mercancía de piso Puebla">
          <option value="Mercancía de piso Queretaro">
          <option value="Mercancía de piso Metepec">
          <option value="Mercancía de piso Polanco">
          <option value="Mercancía de piso Interlomas">
          <option value="Mercancía de piso La viga">
          <option value="Mercancía de piso Toreo">
          <option value="Mercancía de piso Perinorte">
          <option value="Mercancía de piso Gustavo baz">
          <option value="Mercancía de piso Miramontes">
          <option value="Mercancía de piso Santa fe">
          <option value="Mercancía de piso Zaragoza">
          <option value="Planta entrega directo">
          <option value="Cliente recolecta en tienda">
        </datalist>
      </div>
      <div class="full"><label class="f">Nota</label><textarea id="fNota" placeholder="Detalle adicional (opcional)" style="min-height:44px;"></textarea></div>
    </div>
    <p class="err" id="formErr" style="display:none;"></p>
    <button class="btn" id="addBtn">Agregar jaula</button>
  </div>

  <div class="section-title">Jaulas del día <span class="n" id="countLabel"></span></div>
  <div class="entries" id="entriesList"></div>

  <div class="section-title">Buscar por código <span class="n">todas las fechas</span></div>
  <div class="panel">
    <div class="search">
      <input type="text" id="searchInput" placeholder="Ej. OZA1326" style="font-family:var(--font-mono);text-transform:uppercase;">
      <button class="btn secondary" id="searchBtn">Buscar</button>
    </div>
    <div id="searchResults"></div>
  </div>

</div>

<script>
function todayStr(){
  const d = new Date();
  return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
}
function fmtDateLabel(iso){
  const [y,m,d] = iso.split('-');
  const meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  return d + ' ' + meses[parseInt(m,10)-1] + ' ' + y;
}
function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

const dateInput = document.getElementById('routeDate');
const dateHint = document.getElementById('dateHint');
const entriesList = document.getElementById('entriesList');
const countLabel = document.getElementById('countLabel');
dateInput.value = todayStr();

async function keyFor(date){ return 'ruta:' + date; }

let storageAvailable = true;
const memStore = {};

function showStorageBanner(){
  const el = document.getElementById('storageBanner');
  el.style.display = 'block';
  el.textContent = 'Aviso: el guardado compartido no está disponible en esta vista, así que los cambios solo se conservan mientras esta ventana esté abierta. Para que se guarden y todo el equipo los vea, abre este archivo dentro de Claude (como artefacto) y no como archivo descargado o vista externa.';
}

async function storageGet(key, shared){
  if(!storageAvailable){
    return memStore[key] ? {key, value: memStore[key], shared} : null;
  }
  try{
    if(!window.storage) throw new Error('no storage');
    return await window.storage.get(key, shared);
  }catch(e){
    storageAvailable = false;
    showStorageBanner();
    return memStore[key] ? {key, value: memStore[key], shared} : null;
  }
}
async function storageSet(key, value, shared){
  if(!storageAvailable){
    memStore[key] = value;
    return {key, value, shared};
  }
  try{
    if(!window.storage) throw new Error('no storage');
    const res = await window.storage.set(key, value, shared);
    if(!res) throw new Error('empty result');
    return res;
  }catch(e){
    storageAvailable = false;
    showStorageBanner();
    memStore[key] = value;
    return {key, value, shared};
  }
}
async function storageList(prefix, shared){
  if(!storageAvailable){
    return {keys: Object.keys(memStore).filter(k=>k.startsWith(prefix))};
  }
  try{
    if(!window.storage) throw new Error('no storage');
    return await window.storage.list(prefix, shared);
  }catch(e){
    storageAvailable = false;
    showStorageBanner();
    return {keys: Object.keys(memStore).filter(k=>k.startsWith(prefix))};
  }
}

async function loadEntries(date){
  try{
    const res = await storageGet(await keyFor(date), true);
    if(!res) return [];
    return JSON.parse(res.value);
  }catch(e){
    return [];
  }
}
async function saveEntries(date, entries){
  try{
    const res = await storageSet(await keyFor(date), JSON.stringify(entries), true);
    return !!res;
  }catch(e){
    return false;
  }
}

function fmtTs(ts){
  return new Date(ts).toLocaleString('es-MX',{hour:'2-digit',minute:'2-digit',day:'2-digit',month:'2-digit',year:'numeric'});
}

async function renderEntries(){
  const date = dateInput.value;
  dateHint.textContent = fmtDateLabel(date);
  entriesList.innerHTML = '<div class="empty">Cargando...</div>';
  const entries = await loadEntries(date);
  entries.sort((a,b)=> (a.ts||0) - (b.ts||0));
  countLabel.textContent = entries.length ? entries.length + (entries.length===1?' jaula':' jaulas') : '';
  if(!entries.length){
    entriesList.innerHTML = '<div class="empty">Todavía no hay jaulas para esta fecha.</div>';
    return;
  }
  entriesList.innerHTML = '';
  entries.forEach(en=>{
    const div = document.createElement('div');
    div.className = 'ticket';
    div.setAttribute('data-id', en.id);
    renderTicketView(div, en, date);
    entriesList.appendChild(div);
  });
}

function renderTicketView(div, en, date){
  const tipoBadge = en.tipo ? '<span class="tipo-badge">'+escapeHtml(en.tipo)+'</span>' : '';
  const history = en.history || [];
  const lastEdit = history.length > 1 ? history[history.length-1] : null;
  div.innerHTML =
    '<div class="parada">'+escapeHtml(en.parada||'—')+'</div>'+
    '<div class="ticket-body">'+
      '<span class="stamp">'+escapeHtml(en.codigo||'sin código')+'</span>'+tipoBadge+
      (en.nota ? '<p class="nota">'+escapeHtml(en.nota)+'</p>' : '')+
      '<div class="meta">agregado '+ fmtTs(en.ts) +(lastEdit ? ' · editado '+fmtTs(lastEdit.ts) : '')+'</div>'+
      (history.length ? '<button class="hist-toggle" data-action="hist">ver historial ('+history.length+')</button><div class="hist-list" style="display:none;"></div>' : '')+
    '</div>'+
    '<div class="actions">'+
      '<button class="iconbtn" data-action="edit">Editar</button>'+
    '</div>';

  div.querySelector('[data-action="edit"]').addEventListener('click', ()=>{
    renderTicketEdit(div, en, date);
  });
  const histBtn = div.querySelector('[data-action="hist"]');
  if(histBtn){
    histBtn.addEventListener('click', ()=>{
      const listDiv = div.querySelector('.hist-list');
      if(listDiv.style.display === 'none'){
        listDiv.innerHTML = history.slice().reverse().map(h=>{
          const label = h.accion === 'creado' ? 'creado' : 'editado';
          return '<span>'+label+' · '+fmtTs(h.ts)+'</span>';
        }).join('');
        listDiv.style.display = 'flex';
        histBtn.textContent = 'ocultar historial';
      } else {
        listDiv.style.display = 'none';
        histBtn.textContent = 'ver historial ('+history.length+')';
      }
    });
  }
}

function renderTicketEdit(div, en, date){
  div.innerHTML =
    '<div class="ticket-body" style="width:100%;">'+
      '<div class="edit-form">'+
        '<div><label class="f">Jaula</label><input type="text" class="e-parada" placeholder="1" value="'+escapeHtml(en.parada||'')+'"></div>'+
        '<div><label class="f">Código</label><input type="text" class="e-codigo" placeholder="OZA1326" value="'+escapeHtml(en.codigo||'')+'" style="font-family:var(--font-mono);text-transform:uppercase;"></div>'+
        '<div class="full"><label class="f">Tipo</label><input type="text" class="e-tipo" placeholder="Mercancía de piso Puebla" value="'+escapeHtml(en.tipo||'')+'" list="tiposList"></div>'+
        '<div class="full"><label class="f">Nota</label><textarea class="e-nota" style="min-height:44px;">'+escapeHtml(en.nota||'')+'</textarea></div>'+
      '</div>'+
      '<p class="err" style="display:none;"></p>'+
      '<div class="edit-actions">'+
        '<button class="btn small" data-action="save">Guardar cambios</button>'+
        '<button class="btn secondary small" data-action="cancel">Cancelar</button>'+
      '</div>'+
    '</div>';

  div.querySelector('[data-action="cancel"]').addEventListener('click', ()=>{
    renderTicketView(div, en, date);
  });
  div.querySelector('[data-action="save"]').addEventListener('click', async ()=>{
    const parada = div.querySelector('.e-parada').value.trim();
    const codigo = div.querySelector('.e-codigo').value.trim().toUpperCase();
    const tipo = div.querySelector('.e-tipo').value.trim();
    const nota = div.querySelector('.e-nota').value.trim();
    const err = div.querySelector('.err');
    if(!codigo && !nota){
      err.textContent = 'Ingresa al menos un código o una nota.';
      err.style.display = 'block';
      return;
    }
    const list = await loadEntries(date);
    const idx = list.findIndex(x=>x.id===en.id);
    if(idx === -1){ renderEntries(); return; }
    const history = list[idx].history || [{ts:list[idx].ts, accion:'creado'}];
    history.push({ts:Date.now(), accion:'editado'});
    list[idx] = {...list[idx], parada, codigo, tipo, nota, history};
    const ok = await saveEntries(date, list);
    if(!ok){
      err.textContent = 'No se pudo guardar. Intenta de nuevo.';
      err.style.display = 'block';
      return;
    }
    renderEntries();
  });
}

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

dateInput.addEventListener('change', renderEntries);

document.getElementById('todayBtn').addEventListener('click', ()=>{
  dateInput.value = todayStr();
  renderEntries();
});

document.getElementById('addBtn').addEventListener('click', async ()=>{
  const parada = document.getElementById('fParada').value.trim();
  const codigo = document.getElementById('fCodigo').value.trim().toUpperCase();
  const tipo = document.getElementById('fTipo').value.trim();
  const nota = document.getElementById('fNota').value.trim();
  const err = document.getElementById('formErr');
  if(!codigo && !nota){
    err.textContent = 'Ingresa al menos un código o una nota.';
    err.style.display = 'block';
    return;
  }
  err.style.display = 'none';
  const date = dateInput.value;
  const list = await loadEntries(date);
  list.push({id:uid(), parada, codigo, tipo, nota, ts:Date.now(), history:[{ts:Date.now(), accion:'creado'}]});
  const ok = await saveEntries(date, list);
  if(!ok){
    err.textContent = 'No se pudo guardar. Intenta de nuevo.';
    err.style.display = 'block';
    return;
  }
  document.getElementById('fParada').value='';
  document.getElementById('fCodigo').value='';
  document.getElementById('fTipo').value='';
  document.getElementById('fNota').value='';
  renderEntries();
});

document.getElementById('searchBtn').addEventListener('click', async ()=>{
  const q = document.getElementById('searchInput').value.trim().toUpperCase();
  const resultsDiv = document.getElementById('searchResults');
  if(!q){ resultsDiv.innerHTML = ''; return; }
  resultsDiv.innerHTML = '<div class="empty">Buscando...</div>';
  try{
    const listing = await storageList('ruta:', true);
    const keys = listing ? listing.keys : [];
    let found = [];
    for(const k of keys){
      try{
        const res = await storageGet(k, true);
        if(!res) continue;
        const entries = JSON.parse(res.value);
        entries.forEach(en=>{
          if((en.codigo||'').toUpperCase().includes(q)){
            found.push({date: k.replace('ruta:',''), entry: en});
          }
        });
      }catch(e){}
    }
    if(!found.length){
      resultsDiv.innerHTML = '<div class="empty">Sin resultados para "'+escapeHtml(q)+'".</div>';
      return;
    }
    found.sort((a,b)=> b.date.localeCompare(a.date));
    resultsDiv.innerHTML = '';
    let lastDate = null;
    found.forEach(({date, entry})=>{
      if(date !== lastDate){
        const h = document.createElement('div');
        h.className = 'result-date';
        h.textContent = fmtDateLabel(date);
        resultsDiv.appendChild(h);
        lastDate = date;
      }
      const div = document.createElement('div');
      div.className = 'ticket';
      div.innerHTML =
        '<div class="parada">'+escapeHtml(entry.parada||'—')+'</div>'+
        '<div class="ticket-body">'+
          '<span class="stamp">'+escapeHtml(entry.codigo||'sin código')+'</span>'+
          (entry.tipo ? '<span class="tipo-badge">'+escapeHtml(entry.tipo)+'</span>' : '')+
          (entry.nota ? '<p class="nota">'+escapeHtml(entry.nota)+'</p>' : '')+
        '</div>';
      resultsDiv.appendChild(div);
    });
  }catch(e){
    resultsDiv.innerHTML = '<div class="empty">No se pudo buscar. Intenta de nuevo.</div>';
  }
});

renderEntries();
</script>
</body>
</html>
